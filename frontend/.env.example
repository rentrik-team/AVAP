# =============================================================================
# AVAP Frontend — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in the value for your environment.
# NEVER commit .env.local (or any real .env file) to version control.
#
# Every NEXT_PUBLIC_* variable is bundled into the browser JavaScript and is
# publicly visible. Only non-secret, public configuration belongs here.
# =============================================================================

# Base URL of the deployed AVAP FastAPI backend (no trailing slash, no
# /api/v1 suffix — that version prefix is appended centrally by the app).
# Local backend dev server default:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
