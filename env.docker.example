# =============================================================================
# AVAP — Docker Compose configuration template
# =============================================================================
# On Dokploy: paste these into the service's Environment tab.
# Locally: copy to `.env` next to docker-compose.yml. NEVER commit the .env.
#
#   cp env.docker.example .env
# =============================================================================

# --- Required -----------------------------------------------------------------

# Database password (compose refuses to start without it).
POSTGRES_PASSWORD=change-this-strong-password

# Public hostnames. Hostnames ONLY — no scheme, no trailing slash, no port.
# The compose file adds https:// and derives from these:
#   - the Traefik router rules for both services
#   - the backend's allowed CORS origin (from FRONTEND_DOMAIN)
#   - the API URL compiled into the browser bundle (from BACKEND_DOMAIN)
# Changing BACKEND_DOMAIN requires a Redeploy, not a Restart — it is baked
# into the JS bundle at image build time.
FRONTEND_DOMAIN=avap.rentrik.in
BACKEND_DOMAIN=api-avap.rentrik.in

# OpenRouter API key (https://openrouter.ai/). Leave empty to run without AI:
# scans, risk scoring, and reports still work; AI vulnerability inference and
# AI remediation will simply fail gracefully and be recorded in the audit log.
OPENROUTER_API_KEY=

# --- Optional -----------------------------------------------------------------

POSTGRES_DB=avap
POSTGRES_USER=avap_user
ENVIRONMENT=production
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1024
SCAN_TIMEOUT=300
LOG_LEVEL=INFO
