# =============================================================================
# AVAP — Docker Compose configuration template
# =============================================================================
# Copy this file to `.env` in the repository root (next to docker-compose.yml)
# and edit the values. NEVER commit the resulting .env file.
#
#   cp env.docker.example .env
#
# Every value here except OPENROUTER_API_KEY has a working default for a
# single-machine deployment at http://localhost:3000.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Database password (required — compose refuses to start without it).
POSTGRES_PASSWORD=change-this-strong-password

# OpenRouter API key (https://openrouter.ai/). Leave empty to run without AI:
# scans, risk scoring, and reports still work; AI vulnerability inference and
# AI remediation will simply fail gracefully and be recorded in the audit log.
OPENROUTER_API_KEY=

# --- Common overrides ---------------------------------------------------------

# Where the user's BROWSER reaches the backend API. For access from other
# machines, replace localhost with this host's IP or DNS name.
# No trailing slash, no /api/v1 suffix. Changing this requires a rebuild
# (docker compose build frontend) because it is baked into the JS bundle.
FRONTEND_API_BASE_URL=http://localhost:8000

# Browser origin(s) allowed by backend CORS — must match how you open the UI.
# Comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Published ports on the host.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Optional -----------------------------------------------------------------

POSTGRES_DB=avap
POSTGRES_USER=avap_user
ENVIRONMENT=production
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1024
SCAN_TIMEOUT=300
LOG_LEVEL=INFO
