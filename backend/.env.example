# =============================================================================
# Automated Vulnerability Assessment Platform (AVAP)
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AVAP
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Option 1: Full connection URL (takes precedence if set)
# DATABASE_URL=postgresql://user:password@localhost:5432/avap

# Option 2: Individual connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=avap
POSTGRES_USER=avap_user
POSTGRES_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Scanner Configuration
# -----------------------------------------------------------------------------
NMAP_EXECUTABLE=/usr/bin/nmap
SCAN_TIMEOUT=300

OPENVAS_HOST=localhost
OPENVAS_PORT=9390
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=changeme

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# Selects the active provider implementation (currently: openrouter)
AI_PROVIDER=openrouter
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1024

OPENROUTER_API_KEY=changeme
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free/open-source model by default; override with any OpenRouter model slug.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

GROQ_API_KEY=changeme
GEMINI_API_KEY=changeme
HUGGINGFACE_API_KEY=changeme

# -----------------------------------------------------------------------------
# Reporting
# -----------------------------------------------------------------------------
REPORT_OUTPUT_DIRECTORY=./generated_reports

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIRECTORY=./logs
