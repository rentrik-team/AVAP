# =============================================================================
# Automated Vulnerability Assessment Platform (AVAP) — Backend
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file (or any real secret) to version control.
#
# When running under Docker Compose these variables are injected as container
# environment variables instead — see docker-compose.yml and deployment.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AVAP
APP_VERSION=1.0.0
# development | staging | production | testing
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# CORS (separately-deployed Next.js frontend)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Add the deployed frontend
# origin(s) in production; never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Option 1: Full connection URL (takes precedence if set)
# DATABASE_URL=postgresql://avap_user:changeme@localhost:5432/avap

# Option 2: Individual connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=avap
POSTGRES_USER=avap_user
POSTGRES_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Scanner Configuration
# -----------------------------------------------------------------------------
# Absolute path to the Nmap binary. Inside the Docker image this is
# /usr/bin/nmap (already set by the image); on Windows hosts it is
# typically C:\Program Files (x86)\Nmap\nmap.exe.
NMAP_EXECUTABLE=/usr/bin/nmap
SCAN_TIMEOUT=300

# OpenVAS is a deliberate stub adapter — these values are read but no live
# OpenVAS connection is made.
OPENVAS_HOST=localhost
OPENVAS_PORT=9390
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=changeme

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# Selects the active provider implementation (currently: openrouter)
AI_PROVIDER=openrouter
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1024

# Create a key at https://openrouter.ai/ — keep it secret.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free/open-source model by default; override with any OpenRouter model slug.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Contract-ready stubs — no adapter code exists for these yet.
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# -----------------------------------------------------------------------------
# Reporting
# -----------------------------------------------------------------------------
REPORT_OUTPUT_DIRECTORY=./generated_reports
SCANNER_OUTPUT_DIRECTORY=./scan_output

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIRECTORY=./logs
